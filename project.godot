; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="KILLBOX"
config/description="Supervivencia, alianzas y traicion. Prototipo V1."
run/main_scene="res://scenes/login/Login.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[autoload]

AppVersion="*res://autoload/AppVersion.gd"
GameState="*res://autoload/GameState.gd"
CharacterDB="*res://autoload/CharacterDB.gd"
StarsService="*res://autoload/StarsService.gd"
RemoteConfig="*res://autoload/RemoteConfig.gd"
UpdateChecker="*res://autoload/UpdateChecker.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"
window/energy_saving/keep_screen_on=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
